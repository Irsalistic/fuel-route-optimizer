{
  "info": {
    "name": "Fuel route optimizer",
    "description": "Drive between two US cities and get fuel stops, cost, and a route line. Run the Django server on port 8000 first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "New York to Los Angeles",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/route/?start=New York, NY&end=Los Angeles, CA",
        "description": "Cross-country trip. First call hits OSRM once. Send it again and routing_api_calls should be 0."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('has a fuel bill and stops', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.fuel.total_cost).to.be.a('number');",
              "  pm.expect(body.stops.length).to.be.above(0);",
              "  pm.expect(body.routing_api_calls).to.be.oneOf([0, 1]);",
              "  pm.expect(body.route.type).to.eql('LineString');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Chicago to Dallas (POST)",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"end\": \"Dallas, TX\"\n}"
        },
        "url": "{{baseUrl}}/api/route/",
        "description": "Same planner, JSON body instead of query params."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('line items add up', function () {",
              "  const body = pm.response.json();",
              "  const cost = body.stops.reduce(function (sum, stop) { return sum + stop.cost; }, 0);",
              "  pm.expect(Math.abs(cost - body.fuel.total_cost)).to.be.below(0.02);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Boston to Providence (no stop)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/route/?start=Boston, MA&end=Providence, RI",
        "description": "About 50 miles. The tank starts full, so the bill is zero."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('no purchase', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.stops).to.eql([]);",
              "  pm.expect(body.fuel.total_cost).to.eql(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown city",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/route/?start=NotARealTownXYZ, KS&end=Denver, CO",
        "description": "400. This does not call the routing service."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 400', function () { pm.response.to.have.status(400); });",
              "pm.test('error message', function () { pm.expect(pm.response.json().error).to.be.a('string'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Outside the US",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/route/?start=Toronto, ON&end=Denver, CO"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 400', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Missing end",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Denver, CO\"\n}"
        },
        "url": "{{baseUrl}}/api/route/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 400', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Map page",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/map/?start=New York, NY&end=Los Angeles, CA",
        "description": "HTML map. Open this URL in a browser. The page calls /api/route/ once."
      }
    }
  ]
}
